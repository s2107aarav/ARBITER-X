set(root "${BUILD_DIR}/cli-validation")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")

function(expect_exit expected)
  execute_process(COMMAND "${PROGRAM}" ${ARGN}
    WORKING_DIRECTORY "${root}"
    RESULT_VARIABLE actual OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT actual STREQUAL "${expected}")
    message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${actual}: ${output}${error}")
  endif()
endfunction()

foreach(command IN ITEMS simulate verify replay worldcheck worldjump worldfork flagship simstats fuzz)
  expect_exit(2 "${command}" --unknown)
endforeach()
expect_exit(2 simulate --out)
expect_exit(2 verify --seed " -1")
expect_exit(2 replay --journal missing --book invalid)
expect_exit(2 flagship --flow invalid)
expect_exit(2 flagship --config missing --flow poisson)
expect_exit(2 flagship --reproduce missing --config missing)
expect_exit(2 flagship --seed 18446744073709551615 --seeds 2)
expect_exit(2 fuzz --target adversarial --iters 4294967296)
expect_exit(2 journal inspect missing extra)
foreach(definition IN ITEMS "[latency]\ntotal_ns=oops\n" "[market]\nflow_model=invalid\n"
    "[market]\nbots_observe_shadow=maybe\n" "[experiment]\nseeds=1,,2\n"
    "[latency]\nmd_shares=0.5\n" "[experiment]\nunknown=1\n")
  file(WRITE "${root}/invalid.axexp" "${definition}")
  expect_exit(2 flagship --config "${root}/invalid.axexp")
endforeach()
expect_exit(0 simulate --ms 1 --out "${root}/nested/run")
expect_exit(0 journal verify "${root}/nested/run.journal")
expect_exit(0 replay --journal "${root}/nested/run.journal" --book ref)
expect_exit(0 replay --journal "${root}/nested/run.journal" --book opt)
file(APPEND "${root}/nested/run.journal" "x")
expect_exit(1 journal inspect "${root}/nested/run.journal")
expect_exit(1 journal verify "${root}/nested/run.journal")
expect_exit(0 journal recover "${root}/nested/run.journal")
expect_exit(0 journal verify "${root}/nested/run.journal")
